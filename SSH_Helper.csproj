<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;bin/**;obj/**;SSH_Helper.Tests/**;RebexPOC/**;FlowCanvas/tools/**</DefaultItemExcludes>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>true</UseAppHost>
    <WebView2LoaderPreference>Static</WebView2LoaderPreference>
    <RebexLicenseKey Condition="'$(REBEX_LICENSE_KEY)' != ''">$(REBEX_LICENSE_KEY)</RebexLicenseKey>
    <PortableBuild Condition="'$(PortableBuild)' == ''">false</PortableBuild>
  </PropertyGroup>

  <!-- Portable build flavor -->
  <PropertyGroup Condition="'$(PortableBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);PORTABLE_BUILD</DefineConstants>
    <AssemblyName>SSH_Helper_Portable</AssemblyName>
  </PropertyGroup>

  <!-- Single-file publish configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Build timestamp embedded at compile time -->
  <PropertyGroup>
    <BuildTimestamp>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</BuildTimestamp>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts/**/*.cs;bin/**/*.cs;obj/**/*.cs;SSH_Helper.Tests/**/*.cs;RebexPOC/**/*.cs;FlowCanvas/tools/**/*.cs" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$(BuildTimestamp)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(RebexLicenseKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RebexLicenseKey</_Parameter1>
      <_Parameter2>$(RebexLicenseKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Copy rebex.key to output if it exists (for local development) -->
  <ItemGroup Condition="Exists('rebex.key')">
    <None Include="rebex.key" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SSH_Helper.Tests" />
    <InternalsVisibleTo Include="FlowCanvasParityCli" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CronExpressionDescriptor" Version="2.45.0" />
    <PackageReference Include="Cronos" Version="0.11.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Rebex.SshShell" Version="7.0.9561" />
    <PackageReference Include="Scintilla5.NET" Version="6.1.1" GeneratePathProperty="true" />
    <PackageReference Include="SSH.NET" Version="2024.1.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup Condition="Exists('libs\RebexElliptic\net8.0\Rebex.Castle.dll')">
    <Reference Include="Rebex.Castle">
      <HintPath>libs\RebexElliptic\net8.0\Rebex.Castle.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Rebex.Curve25519">
      <HintPath>libs\RebexElliptic\net8.0\Rebex.Curve25519.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Rebex.Ed25519">
      <HintPath>libs\RebexElliptic\net8.0\Rebex.Ed25519.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Remove="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3124.44\lib_manual\net5.0-windows10.0.17763.0\Microsoft.Web.WebView2.Wpf.dll" />
  </ItemGroup>

  <!-- Build FlowCanvas Vite app before .NET build -->
  <Target Name="BuildFlowCanvas" BeforeTargets="BeforeBuild" Condition="Exists('FlowCanvas\package.json') and '$(SkipFlowCanvasBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="FlowCanvas" />
  </Target>

  <!-- Embed FlowCanvas dist assets so single-file publish can extract them at runtime -->
  <Target Name="IncludeFlowCanvasDistEmbeddedResources"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="BuildFlowCanvas"
          Condition="Exists('FlowCanvas\dist\index.html')">
    <ItemGroup>
      <_FlowCanvasDistFile Include="FlowCanvas\dist\**\*" />
      <EmbeddedResource Include="@(_FlowCanvasDistFile)">
        <LogicalName>SSH_Helper.Resources.FlowCanvasDist/%(_FlowCanvasDistFile.RecursiveDir)%(_FlowCanvasDistFile.Filename)%(_FlowCanvasDistFile.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(Reference.Identity)' != '' and $([System.String]::Copy('%(Reference.Identity)').EndsWith('Microsoft.Web.WebView2.Wpf.dll'))" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(PkgScintilla5_NET)' != ''">
    <EmbeddedResource Include="$(PkgScintilla5_NET)\runtimes\win-x64\native\Scintilla.dll">
      <LogicalName>SSH_Helper.Resources.Scintilla.win-x64.Scintilla.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PkgScintilla5_NET)\runtimes\win-x64\native\Lexilla.dll">
      <LogicalName>SSH_Helper.Resources.Scintilla.win-x64.Lexilla.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
