<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../SSH_Helper.csproj" />
  </ItemGroup>

  <!-- Strip WindowsDesktop framework from runtimeconfig so the CLI can run on Linux CI runners.
       The CLI only uses scripting/bridge logic, never WinForms types at runtime. -->
  <Target Name="StripWindowsDesktopRuntime" BeforeTargets="GenerateBuildRuntimeConfigurationFiles">
    <ItemGroup>
      <RuntimeFramework Remove="Microsoft.WindowsDesktop.App" />
    </ItemGroup>
  </Target>
</Project>
